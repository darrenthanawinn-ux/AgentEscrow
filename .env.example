# ───────── Mock / Live switch ─────────
# In `next dev` mock mode is ON by default (NODE_ENV === 'development').
# For a production build (e.g. Vercel) set ENABLE_MOCK=true to force mock mode.
ENABLE_MOCK=true

# If a live call fails (timeout, 5xx, bad creds) fall back to mock automatically.
ALLOW_MOCK_FALLBACK=true

# Live call timeout in ms (PayPal + LLM)
SERVICE_TIMEOUT_MS=12000

# ───────── PayPal Sandbox ─────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ───────── LLM (pick one) ─────────
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                      # optional override (defaults: claude-sonnet-4-5 / gpt-4o-mini)

# Used to sign verification proofs so payouts can't be triggered without a passing evaluation
APP_SECRET=change-me-for-your-demo
